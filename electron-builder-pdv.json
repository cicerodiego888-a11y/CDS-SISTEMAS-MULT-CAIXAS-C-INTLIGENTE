{
  "appId": "com.cdssistemas.pdv",
  "productName": "CDS PDV",
  "copyright": "Copyright © 2026 CDS Sistemas - Cicero Diego",
  "directories": {
    "output": "dist/pdv"
  },
  "files": [
    "**/*",
    "!dist/**",
    "!dist-*/**",
    "!release/**",
    "!out/**",
    "!build/**",
    "!tests/**",
    "!scripts/**",
    "!dados/**",
    "!backups/**",
    "!backend/banco/**",
    "!backend/storage/**",
    "!storage/**",
    "!logs/**",
    "!tmp/**",
    "!docs/**",
    "!imagem/**",
    "!config/configuracoes.json",
    "!electron-build-manifest.json",
    "!package-lock.json",
    "!check-users.js",
    "!diagnostico-*.js",
    "!tmp-sprint*.js",
    "!backend/teste_*.js",
    "!backend/test_*.js",
    "!backend/scripts/**",
    "!**/*.db",
    "!**/*.db-shm",
    "!**/*.db-wal",
    "!**/*.db-journal",
    "!**/*.sqlite",
    "!**/*.sqlite3",
    "!**/*.pfx",
    "!**/*.p12",
    "!**/*.key",
    "!**/*.log",
    "!electron.js",
    "!electron-erp.js",
    "!electron-builder-erp.json",
    "!**/.git/**",
    "!**/.gitignore",
    "!**/.gitattributes",
    "!**/.cursorignore",
    "!**/.gitkeep",
    "!**/.cursor/**",
    "!backend/**/debug/**",
    "!backend/schemas/nfe_v4.00/temp-nfe/**",
    "!**/*.zip",
    "!Logo.jpeg",
    "!**/*.md",
    "!**/{.DS_Store,Thumbs.db,Desktop.ini}",
    "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!**/node_modules/.bin/**"
  ],
  "asarUnpack": [
    "**/node_modules/sqlite3/**",
    "**/node_modules/usb/**",
    "**/resources/tef/destaxa/**"
  ],
  "afterPack": "./build/electron/afterPack.js",
  "extraMetadata": {
    "main": "electron-pdv.js"
  },
  "win": {
    "target": "nsis",
    "icon": "assets/branding/icon.ico",
    "signAndEditExecutable": false,
    "signtoolOptions": {
      "publisherName": "CDS Sistemas"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CDS PDV",
    "artifactName": "CDS-PDV-Setup-${version}.${ext}",
    "uninstallDisplayName": "CDS PDV"
  }
}
